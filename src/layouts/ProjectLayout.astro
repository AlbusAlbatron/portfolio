---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from './Base.astro';
import SplitText from '../components/SplitText.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, year, tech, repo, cover, gallery, video } = project.data;

// Video files are plain assets: Vite hashes and copies whatever src/assets/projects/<id>/ holds.
const videoFiles = import.meta.glob<string>('../assets/projects/*/*.{webm,mp4}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const videoUrl = (name?: string) => (name ? videoFiles[`../assets/projects/${project.id}/${name}`] : undefined);
const webm = videoUrl(video?.webm);
const mp4 = videoUrl(video?.mp4);
const poster = video ? await getImage({ src: video.poster, width: 1600, format: 'webp' }) : undefined;
const hasMedia = Boolean(video || cover || gallery?.length);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: title,
    description: summary,
    url: pageUrl,
    codeRepository: repo,
    programmingLanguage: tech[0],
    dateCreated: String(year),
    author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  },
];
---

<Base title={title} description={summary} ogImage={`/og/projects/${project.id}.png`}>
  <JsonLd data={jsonLd} />
  <article>
    <header class="wrap phead" data-surface="dark" data-index="Overview">
      <a href="/projects" class="label phead__back" data-reveal>← All projects</a>
      <SplitText text={title} delay={60} data-parallax="0.12" data-vt={`project-${project.id}`} />
      <p class="phead__summary" data-reveal style="--reveal-delay: 140">{summary}</p>
      <dl class="phead__meta" data-reveal style="--reveal-delay: 220">
        <div><dt class="label">Year</dt><dd>{year}</dd></div>
        <div><dt class="label">Built with</dt><dd>{tech.join(', ')}</dd></div>
        <div>
          <dt class="label">Source</dt>
          <dd><a href={repo}>GitHub ↗</a></dd>
        </div>
      </dl>
    </header>

    {
      hasMedia && (
        <div class="wrap pmedia" data-surface="dark">
          {video && poster ? (
            <figure
              class="pmedia__video"
              data-video
              data-reveal
              style={`aspect-ratio: ${video.poster.width} / ${video.poster.height}`}
            >
              <video
                muted
                loop
                playsinline
                preload="none"
                poster={poster.src}
                width={video.poster.width}
                height={video.poster.height}
                aria-label={`${title} running for real`}
              >
                {webm && <source src={webm} type="video/webm" />}
                {mp4 && <source src={mp4} type="video/mp4" />}
              </video>
              <button type="button" class="pmedia__play button" data-play aria-pressed="false" hidden>
                Play
              </button>
              <figcaption class="label pmedia__caption">The real thing</figcaption>
            </figure>
          ) : (
            cover && (
              <figure class="pmedia__cover" data-reveal>
                <Image
                  src={cover}
                  alt=""
                  widths={[720, 1200, 1800]}
                  sizes="(max-width: 72rem) 100vw, 72rem"
                  loading="eager"
                  fetchpriority="high"
                />
              </figure>
            )
          )}
          {gallery && gallery.length > 0 && (
            <ul class="pmedia__gallery">
              {gallery.map((g, i) => (
                <li data-reveal style={`--reveal-delay: ${i * 80}`}>
                  <figure>
                    <Image src={g.src} alt={g.alt} widths={[480, 960]} sizes="(max-width: 48rem) 100vw, 36rem" />
                    {g.caption && <figcaption class="label">{g.caption}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }

    <div data-surface="light">
      <slot />
    </div>
  </article>
</Base>

<script>
  // Recordings play silently while in view. Under reduced motion nothing autoplays: a Play button appears.
  let teardown: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    const fig = document.querySelector<HTMLElement>('[data-video]');
    const video = fig?.querySelector('video');
    if (!fig || !video) return;
    const play = fig.querySelector<HTMLButtonElement>('[data-play]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce) {
      play.hidden = false;
      const toggle = () => {
        if (video.paused) void video.play();
        else video.pause();
      };
      const sync = () => {
        play.textContent = video.paused ? 'Play' : 'Pause';
        play.setAttribute('aria-pressed', String(!video.paused));
      };
      play.addEventListener('click', toggle);
      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);
      teardown = () => {
        video.pause();
        play.removeEventListener('click', toggle);
      };
      return;
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) void video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0.4 },
    );
    io.observe(video);
    teardown = () => {
      io.disconnect();
      video.pause();
    };
  });

  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = undefined;
  });
</script>

<style>
  .phead {
    padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
  }

  .phead__back {
    text-decoration: none;
  }

  .phead__back:hover {
    color: var(--text);
  }

  h1 {
    margin-top: 0.5em;
    font-size: clamp(3rem, 11vw, 8rem);
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .phead__summary {
    max-width: 40rem;
    margin-top: 1.5rem;
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    line-height: 1.4;
    color: var(--text-soft);
  }

  .phead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .phead__meta dd {
    margin: 0.3rem 0 0;
  }

  .pmedia {
    display: grid;
    gap: 1rem;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .pmedia figure {
    margin: 0;
  }

  .pmedia__video,
  .pmedia__cover {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-sunken);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }

  .pmedia__video video,
  .pmedia__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pmedia__play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background: var(--bg);
  }

  .pmedia__caption {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    color: var(--text);
  }

  .pmedia__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pmedia__gallery figure {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-sunken);
  }

  .pmedia__gallery :global(img) {
    width: 100%;
  }

  .pmedia__gallery figcaption {
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--line);
    text-transform: none;
    letter-spacing: 0;
  }
</style>

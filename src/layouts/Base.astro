---
import '@fontsource-variable/inter-tight';
import '@fontsource/jetbrains-mono/400.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import PageWipe from '../components/PageWipe.astro';
import SectionIndex from '../components/SectionIndex.astro';
import Palette from '../components/Palette.astro';
import { site } from '../data/site';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import jetbrainsMono from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path of the share image; defaults to the generic one. */
  ogImage?: string;
}

const { title, description = site.description, ogImage = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Software Engineering Student`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-IE" data-surface="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Journal`} href="/rss.xml" />
    <meta name="theme-color" content="#26201b" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullTitle} — alby.software`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Before first paint: mark JS as available and honour a pinned lights preference (see scripts/lights.ts).
      document.documentElement.classList.add('js');
      try {
        var lights = localStorage.getItem('lights');
        if (lights === 'dark' || lights === 'light') {
          document.documentElement.dataset.surface = lights;
          document.documentElement.dataset.lights = lights;
        }
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Cursor />
    <PageWipe />
    <SectionIndex />
    <Palette />
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initSurface } from '../scripts/surface';
      import { initSmooth } from '../scripts/smooth';
      import { initCursor } from '../scripts/cursor';
      import { initWipe } from '../scripts/wipe';
      import { initMorph } from '../scripts/morph';
      import { initLiquid } from '../scripts/liquid';
      import { initTilt } from '../scripts/tilt';
      import { initMagnetic } from '../scripts/magnetic';
      import { initWeight } from '../scripts/weight';
      import { initMarquee } from '../scripts/marquee';
      import { initProgress } from '../scripts/progress';
      import { initCopy } from '../scripts/copy';
      import { initPalette } from '../scripts/palette';
      import { applyLights, getLights, nextLights, setLights } from '../scripts/lights';

      initSmooth();
      initCursor();
      initWipe();
      initMorph();
      initLiquid();
      initTilt();
      initMagnetic();
      initWeight();
      initMarquee();
      initProgress();
      initCopy();
      initPalette();

      // The footer's three-state lights button (auto → dark → light). Delegated: the footer is re-rendered
      // on every navigation.
      const syncLightsButtons = () => {
        const lights = getLights();
        document.querySelectorAll<HTMLButtonElement>('[data-lights-cycle]').forEach((b) => {
          b.hidden = false;
          b.setAttribute('aria-label', `Lights: ${lights}. Switch to ${nextLights(lights)}`);
          const value = b.querySelector('[data-lights-value]');
          if (value) value.textContent = lights;
        });
      };
      document.addEventListener('click', (e) => {
        if ((e.target as Element).closest('[data-lights-cycle]')) setLights(nextLights(getLights()));
      });
      document.addEventListener('lights:change', syncLightsButtons);
      document.addEventListener('astro:page-load', syncLightsButtons);

      document.addEventListener('astro:after-swap', () => {
        // <html> attributes are replaced on every navigation; put ours back before the new page paints.
        document.documentElement.classList.add('js');
        applyLights();
      });
      document.addEventListener('astro:page-load', () => {
        initReveal();
        initSurface();
      });
    </script>
    <script is:inline>
      console.log(
        '%cAlby McNamara%c\nCurious how this is built? https://alby.software/projects/this-site — source: https://github.com/AlbusAlbatron/portfolio',
        'font: 500 18px "Inter Tight", system-ui, sans-serif; letter-spacing: -0.02em',
        'font: 12px ui-monospace, monospace; color: #857a6c',
      );
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--text);
    color: var(--bg);
  }

  .skip:focus {
    top: 1rem;
  }
</style>

---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/anton/latin-400.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import FitText from '../components/FitText.astro';
import { site } from '../data/site';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import instrument from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const built = new Date();
const builtLabel = new Intl.DateTimeFormat('en-IE', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Europe/Dublin',
}).format(built);
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrument} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3f3f0" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip mono" href="#main">Skip to content</a>


    <header class="chrome page">
      <a class="chrome__brand" href="/">
        <span class="chrome__mark" aria-hidden="true"></span>
        <span class="chrome__name" data-dust>{site.name}</span>
      </a>
      <p class="chrome__cell chrome__role muted">Immersive Software Engineering, University of Limerick</p>
      <p class="chrome__cell chrome__where mono muted">
        52.66°N 8.63°W · <time class="num" data-clock>Limerick</time>
      </p>
      <p class="chrome__cell chrome__status">
        <span class="chrome__dot" aria-hidden="true"></span>{site.status}
      </p>
      <Nav />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot page">
      <FitText text={site.name} dust />
      <div class="foot__row small">
        <a class="link" href={`mailto:${site.email}`} data-dust>{site.email}</a>
        <a class="link" href={site.github} data-dust>GitHub</a>
        <a class="link" href={site.linkedin} data-dust>LinkedIn</a>
        <span class="mono muted">Updated {builtLabel} · No tracking</span>
        <a class="link" href="#main">Back to top ↑</a>
      </div>
    </footer>

    <script>
      import '../scripts/chrome';
      import '../scripts/dust';
    </script>
  </body>
</html>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 var(--gap);
    height: var(--chrome);
    background: var(--bg);
    font-size: 0.8125rem;
  }

  .chrome__brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .chrome__mark {
    width: 0.65rem;
    height: 0.65rem;
    background: var(--ink);
  }

  .chrome__cell {
    display: none;
    white-space: nowrap;
  }

  .chrome__dot {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: #1f9d55;
    vertical-align: 0.1em;
  }

  @media (min-width: 72rem) {
    .chrome {
      grid-template-columns: 1.1fr 1.6fr 1.3fr 1.6fr auto;
    }

    .chrome__cell {
      display: block;
    }
  }

  .foot {
    padding-top: var(--section);
    padding-bottom: var(--pad);
    overflow-x: clip;
  }

  /* The footer name runs off the right edge on wide screens. */
  @media (min-width: 64rem) {
    .foot :global(.fit) {
      margin-right: calc(-1 * var(--pad) - 4vw);
    }
  }

  .foot__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
  }

  .foot__row a:last-child {
    margin-left: auto;
  }
</style>

---
// A drawing of each project made from its real numbers, used until screenshots exist.
interface Props {
  id: string;
}
const { id } = Astro.props;

// procedural-animation: radii from the C — (int)(r * 0.8) from 40, then zeros to 40 segments.
const radii: number[] = [40];
while (radii.length < 40) radii.push(Math.trunc(radii[radii.length - 1] * 0.8));
const snake: { x: number; y: number; r: number }[] = [];
{
  let x = 62;
  let y = 120;
  let angle = -0.35;
  for (let i = 0; i < radii.length; i++) {
    snake.push({ x, y, r: radii[i] * 0.9 });
    const spacing = Math.max(radii[i] * 0.9, 6.5);
    angle += 0.19 * Math.cos(i * 0.32);
    x += Math.cos(angle) * spacing;
    y += Math.sin(angle) * spacing;
  }
}
---

<svg class="specimen" viewBox="0 0 400 250" role="img" aria-label={`Diagram of ${id}`}>
  {
    id === 'wingravity' && (
      <g fill="none" stroke="currentColor" stroke-width="1">
        <line x1="12" y1="226" x2="388" y2="226" />
        <g>
          <rect x="40" y="148" width="118" height="78" fill="var(--surface)" />
          <line x1="40" y1="160" x2="158" y2="160" />
        </g>
        <g>
          <rect x="128" y="168" width="96" height="58" fill="var(--surface)" />
          <line x1="128" y1="180" x2="224" y2="180" />
        </g>
        <g>
          <rect x="262" y="42" width="104" height="70" fill="var(--surface)" />
          <line x1="262" y1="54" x2="366" y2="54" />
        </g>
        <g stroke-dasharray="2 3" opacity="0.55">
          <rect x="262" y="12" width="104" height="70" />
          <line x1="314" y1="116" x2="314" y2="196" />
        </g>
        <path d="M309 190 L314 198 L319 190" />
        <text x="20" y="22" fill="currentColor" stroke="none" font-family="var(--mono)" font-size="9">GRAVITY 444.0f</text>
        <text x="20" y="35" fill="currentColor" stroke="none" font-family="var(--mono)" font-size="9">BOUNCE 0.6f</text>
        <text x="20" y="48" fill="currentColor" stroke="none" font-family="var(--mono)" font-size="9">FRICTION 5.0f</text>
        <text x="322" y="160" fill="currentColor" stroke="none" font-family="var(--mono)" font-size="9">vel.y</text>
      </g>
    )
  }
  {
    id === 'attention-service' && (
      <g fill="currentColor" font-family="var(--mono)" font-size="10.5">
        <text x="20" y="40" opacity="0.6">#Start of entries inserted by Attention Service</text>
        <text x="20" y="62">0.0.0.0 youtube.com</text>
        <text x="20" y="80">0.0.0.0 reddit.com</text>
        <text x="20" y="102" opacity="0.6">#End of entries inserted by Attention Service</text>
        <line x1="20" y1="128" x2="380" y2="128" stroke="currentColor" stroke-width="1" opacity="0.35" />
        <text x="20" y="152" opacity="0.6">always blocked while a session runs:</text>
        {['taskmgr.exe', 'cmd.exe', 'powershell.exe', 'mmc.exe', 'regedit.exe'].map((exe, i) => (
          <g>
            <text x={20 + (i % 3) * 120} y={178 + Math.floor(i / 3) * 22}>{exe}</text>
            <line
              x1={20 + (i % 3) * 120}
              x2={20 + (i % 3) * 120 + exe.length * 6.3}
              y1={174 + Math.floor(i / 3) * 22}
              y2={174 + Math.floor(i / 3) * 22}
              stroke="currentColor"
              stroke-width="1"
            />
          </g>
        ))}
      </g>
    )
  }
  {
    id === 'procedural-animation' && (
      <g fill="none" stroke="currentColor" stroke-width="1">
        {snake.map((c) =>
          c.r > 0 ? <circle cx={c.x} cy={c.y} r={c.r} /> : <circle cx={c.x} cy={c.y} r="1.1" fill="currentColor" stroke="none" />,
        )}
        <text x="20" y="232" fill="currentColor" stroke="none" font-family="var(--mono)" font-size="9">
          r = (int)(r * 0.8) → {radii.filter((r) => r > 0).join(', ')}, 0, 0, 0…
        </text>
      </g>
    )
  }
</svg>

<style>
  .specimen {
    display: block;
    width: 100%;
    height: auto;
    color: #2a2a26;
  }
</style>

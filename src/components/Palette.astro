---
import { getCollection } from 'astro:content';
import { site } from '../data/site';

// Everything the palette can jump to, decided at build time. Keep it small: it ships on every page.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('journal', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

type Item = { t: string; h?: string; k: string; s?: string; a?: string; ext?: boolean };
const items: Item[] = [
  { t: 'Home', h: '/', k: 'page' },
  { t: 'Projects', h: '/projects', k: 'page' },
  { t: 'Journal', h: '/journal', k: 'page' },
  { t: 'About', h: '/about', k: 'page' },
  { t: 'CV', h: '/cv', k: 'page' },
  ...projects.map((p) => ({ t: p.data.title, h: `/projects/${p.id}`, k: 'project', s: p.data.tech.join(' · ') })),
  ...posts.map((p) => ({ t: p.data.title, h: `/journal/${p.id}`, k: 'note', s: p.data.date.toISOString().slice(0, 10) })),
  { t: 'Copy email address', k: 'action', a: 'copy-email', s: site.email },
  { t: 'Open GitHub', h: site.github, k: 'link', ext: true },
  { t: 'Open LinkedIn', h: site.linkedin, k: 'link', ext: true },
  { t: 'Lights: auto', k: 'action', a: 'lights:auto', s: 'follow the page' },
  { t: 'Lights: dark', k: 'action', a: 'lights:dark' },
  { t: 'Lights: light', k: 'action', a: 'lights:light' },
  { t: 'Keyboard shortcuts', k: 'action', a: 'help', s: '?' },
];

const shortcuts = [
  ['⌘ K', 'Open this palette'],
  ['?', 'Show these shortcuts'],
  ['g h', 'Home'],
  ['g p', 'Projects'],
  ['g j', 'Journal'],
  ['g a', 'About'],
  ['g c', 'CV'],
  ['Esc', 'Close'],
];
---

<dialog class="palette" data-palette aria-label="Command palette" transition:persist="palette">
  <div class="palette__box">
    <div class="palette__head">
      <input
        type="search"
        class="palette__input"
        data-palette-input
        placeholder="Jump to…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label="Search pages, projects and actions"
      />
      <kbd class="palette__esc label">esc</kbd>
    </div>
    <ol id="palette-list" class="palette__list" role="listbox" data-palette-list></ol>
    <section class="palette__help" data-palette-help hidden aria-label="Keyboard shortcuts">
      <dl class="palette__keys">
        {
          shortcuts.map(([key, what]) => (
            <div>
              <dt><kbd>{key}</kbd></dt>
              <dd>{what}</dd>
            </div>
          ))
        }
      </dl>
    </section>
    <p class="palette__foot label">
      <span data-palette-count></span>
      <span>↑↓ to move · ↵ to open</span>
    </p>
    <script type="application/json" data-palette-items set:html={JSON.stringify(items)} is:inline />
  </div>
</dialog>

<style>
  .palette {
    width: min(36rem, calc(100vw - 2 * var(--gutter)));
    margin: clamp(2rem, 12vh, 9rem) auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.7);
    opacity: 0;
    translate: 0 -0.75rem;
    transition:
      opacity 0.2s var(--ease),
      translate 0.25s var(--ease),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  .palette[open] {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .palette[open] {
      opacity: 0;
      translate: 0 -0.75rem;
    }
  }

  .palette::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  /* The dialog sits in the top layer, above the custom cursor: show a real one inside. */
  .palette,
  .palette * {
    cursor: auto !important;
  }

  .palette__box {
    display: grid;
  }

  .palette__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem 0.5rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .palette__input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 1.1rem;
    outline: none;
  }

  .palette__input::placeholder {
    color: var(--text-muted);
  }

  .palette__input::-webkit-search-cancel-button {
    display: none;
  }

  .palette__esc {
    padding: 0.15em 0.5em;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .palette__list {
    max-height: min(22rem, 50vh);
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    overflow-y: auto;
  }

  .palette__list:empty::after {
    content: 'Nothing matches.';
    display: block;
    padding: 1rem 0.75rem;
    color: var(--text-muted);
  }

  .palette__list :global(li) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    cursor: pointer !important;
  }

  .palette__list :global(li[aria-selected='true']) {
    background: var(--bg);
  }

  .palette__list :global(.palette__title) {
    font-weight: 500;
  }

  .palette__list :global(.palette__sub) {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .palette__list :global(.palette__kind) {
    color: var(--text-muted);
  }

  .palette__help {
    padding: 1rem 1.25rem 0.5rem;
  }

  .palette__keys {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .palette__keys div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .palette__keys dd {
    margin: 0;
    color: var(--text-soft);
  }

  .palette kbd {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .palette__keys kbd {
    padding: 0.1em 0.5em;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .palette__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.6rem 1.25rem 0.75rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 40rem) {
    .palette__foot span:last-child {
      display: none;
    }
  }
</style>

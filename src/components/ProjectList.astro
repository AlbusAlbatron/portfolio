---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<ol class="projects">
  {
    projects.map((p, i) => (
      <li data-reveal style={`--reveal-delay: ${i * 90}`} data-hentry={p.data.cover ? '' : undefined}>
        <a class="project" href={`/projects/${p.id}`} data-cursor="view" data-tilt="1.5" data-htrigger={p.data.cover ? '' : undefined}>
          <span class="project__index label">{String(i + 1).padStart(2, '0')}</span>
          <span class="project__title" data-field data-weight data-vt={`project-${p.id}`}><span class="sr-only">{p.data.title}</span><span aria-hidden="true">{[...p.data.title].map((ch) => <span class="wl">{ch}</span>)}</span></span>
          <span class="project__summary" data-field>{p.data.summary}</span>
          <span class="project__meta label" data-field>
            {p.data.tech.join(' · ')}
            {p.data.badge && <span class="project__badge">{p.data.badge}</span>}
          </span>
          <span class="project__arrow" aria-hidden="true">
            →
          </span>
        </a>
        {p.data.cover && (
          <span class="project__preview">
            <span class="project__card" data-hcard aria-hidden="true">
              <Image src={p.data.cover} alt="" width={560} loading="lazy" decoding="async" />
            </span>
          </span>
        )}
      </li>
    ))
  }
</ol>

<script>
  // Cover previews float beside the cursor on fine pointers; the same code drives the CV hover cards.
  import { mountHoverCards } from '../scripts/hovercards';

  let unmount: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    unmount?.();
    const list = document.querySelector<HTMLElement>('.projects');
    unmount = list?.querySelector('[data-hentry]') ? mountHoverCards(list) : undefined;
  });

  document.addEventListener('astro:before-swap', () => {
    unmount?.();
    unmount = undefined;
  });
</script>

<style>
  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .projects li {
    border-bottom: 1px solid var(--line);
  }

  .project {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    grid-template-areas:
      'index title arrow'
      '. summary arrow'
      '. meta arrow';
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding: clamp(1.5rem, 4vw, 2.5rem) 0;
    text-decoration: none;
  }

  .project__index {
    grid-area: index;
    padding-top: 0.6em;
  }

  .project__title {
    grid-area: title;
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    transition: transform 0.5s var(--ease);
  }

  .project__summary {
    grid-area: summary;
    max-width: 36rem;
    color: var(--text-muted);
    transition: color 0.3s var(--ease);
  }

  .project__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .project__badge {
    padding: 0.15em 0.6em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
  }

  .project__arrow {
    grid-area: arrow;
    align-self: center;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--text-faint);
    transition:
      transform 0.5s var(--ease),
      color 0.3s var(--ease);
  }

  .project:hover .project__title {
    transform: translateX(0.5rem);
  }

  .project:hover .project__summary {
    color: var(--text);
  }

  .project:hover .project__arrow {
    color: var(--text);
    transform: translateX(0.5rem);
  }

  /* Cover preview: mouse only. Touch and keyboard users get the cover on the project page itself. */
  .project__preview {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .project__preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 60;
      perspective: 900px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.25s var(--ease),
        visibility 0s linear 0.25s;
    }

    li.is-floating .project__preview {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.25s var(--ease);
    }
  }

  .project__card {
    display: block;
    width: 20rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-raised);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.8);
  }

  .project__card :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 40rem) {
    .project {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'index arrow'
        'title arrow'
        'summary summary'
        'meta meta';
    }

    .project__index {
      padding-top: 0;
    }
  }
</style>

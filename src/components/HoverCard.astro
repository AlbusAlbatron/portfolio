---
import { Image } from 'astro:assets';
import type { CvPreview } from '../data/cv';

interface Props {
  title: string;
  subtitle?: string;
  preview: CvPreview;
}

const { title, subtitle, preview } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/cv/*.{jpg,jpeg,png,webp,avif,svg}', {
  eager: true,
});
const image = preview.image ? images[`../assets/cv/${preview.image}`]?.default : undefined;
const initials = title
  .split(/[\s,]+/)
  .filter((w) => /^[A-Z]/.test(w))
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

<div class="hcard" data-hcard aria-hidden="true">
  <div class="hcard__media">
    {image ? <Image src={image} alt="" width={480} /> : <span class="hcard__initials">{initials}</span>}
  </div>
  <div class="hcard__text">
    <p class="hcard__title">{title}</p>
    {subtitle && <p class="hcard__sub label">{subtitle}</p>}
    {preview.blurb && <p class="hcard__blurb">{preview.blurb}</p>}
  </div>
</div>

<style>
  .hcard {
    width: 17rem;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.8);
    pointer-events: none;
  }

  .hcard__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 10px,
        color-mix(in srgb, var(--text) 4%, transparent) 10px 11px
      ),
      var(--bg-sunken);
    border-bottom: 1px solid var(--line);
  }

  .hcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hcard__initials {
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: -0.05em;
    color: var(--text-faint);
  }

  .hcard__text {
    padding: 0.85rem 1rem 1rem;
  }

  .hcard__text p {
    margin: 0;
  }

  .hcard__title {
    font-weight: 500;
  }

  .hcard__sub {
    margin-top: 0.2rem !important;
  }

  .hcard__blurb {
    margin-top: 0.6rem !important;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>

---
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;
---

<section class="marquee" data-marquee data-surface="light" aria-label={label}>
  <div class="marquee__track" data-marquee-track>
    <ul class="marquee__list">{items.map((item) => <li>{item}</li>)}</ul>
    <ul class="marquee__list" aria-hidden="true">{items.map((item) => <li>{item}</li>)}</ul>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    margin-top: clamp(3rem, 8vw, 6rem);
    border-block: 1px solid var(--line);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__list {
    display: flex;
    margin: 0;
    padding: clamp(1rem, 2.5vw, 1.6rem) 0;
    list-style: none;
    transform: skewX(var(--skew, 0deg));
  }

  .marquee__list li {
    display: flex;
    align-items: center;
    font-size: clamp(1.6rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .marquee__list li::after {
    content: '';
    width: 0.32em;
    height: 0.32em;
    margin-inline: 0.8em;
    border-radius: 50%;
    background: var(--text-muted);
  }
</style>

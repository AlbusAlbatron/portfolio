---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { profile, education, experience, placements, skills, awards, activities, interests } from '../data/cv';

// The download only appears once the redacted web copy has been added at public/cv.pdf.
const hasPdf = existsSync(join(process.cwd(), 'public', 'cv.pdf'));

// Each section is one self-contained "sheet": its heading, a rule and its content move together. On wide screens
// whole sheets are offset by different amounts (in % of the page width) so the page stays brutalist, while
// everything inside a sheet shares one grid and one left edge.
const sections = [
  { id: 'profile', title: 'Profile', shift: 0 },
  { id: 'education', title: 'Education', shift: 8.333 },
  { id: 'experience', title: 'Work experience', shift: 16.667 },
  { id: 'skills', title: 'Skills', shift: 4.167 },
  { id: 'awards', title: 'Awards', shift: 12.5 },
  { id: 'activities', title: 'Activities', shift: 0 },
  { id: 'interests', title: 'Interests', shift: 8.333 },
  { id: 'references', title: 'References', shift: 16.667 },
] as const;
const no = (i: number) => String(i + 1).padStart(2, '0');
const meta = Object.fromEntries(sections.map((s, i) => [s.id, { ...s, no: no(i) }]));
---

<Base
  title="CV"
  description="CV of Alby McNamara, first-year Immersive Software Engineering student at the University of Limerick."
>
  <div class="page">
    <div class="bar mono crumbs">
      <p>Curriculum vitae</p>
      <p class="muted">{site.location}</p>
    </div>
    <header class="head">
      <h1 class="title dust-title outdent" data-dust>{site.name}</h1>
      <p class="head__links small indent-1">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link" href={site.linkedin}>LinkedIn</a>
        <a class="link" href={site.github}>GitHub</a>
        {
          hasPdf && (
            <a class="link" href="/cv.pdf" download="Alby-McNamara-CV.pdf" data-print-hide>
              Download PDF ↓
            </a>
          )
        }
      </p>
      <nav class="contents label indent-1" aria-label="CV sections" data-print-hide>
        <ol>
          {
            sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="pixel muted">{no(i)}</span> {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <section class="sheet" style={`--shift: ${meta.profile.shift}`} aria-labelledby="profile">
      <div class="bar sheet__head">
        <h2 id="profile" class="bar__label"><span>{meta.profile.title}</span><span class="count">{meta.profile.no}</span></h2>
      </div>
      <div class="line">
        <span></span>
        <div class="text">{profile.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section class="sheet" style={`--shift: ${meta.education.shift}`} aria-labelledby="education">
      <div class="bar sheet__head">
        <h2 id="education" class="bar__label"><span>{meta.education.title}</span><span class="count">{meta.education.no}</span></h2>
      </div>
      {
        education.map((e) => (
          <div class="line">
            <p class="mono muted">{e.dates}</p>
            <div>
              <h3 class="line__title">{e.org}</h3>
              <p class="muted">{e.role}</p>
              {e.points.length > 0 && (
                <ul class="points">
                  {e.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <section class="sheet" style={`--shift: ${meta.experience.shift}`} aria-labelledby="experience">
      <div class="bar sheet__head">
        <h2 id="experience" class="bar__label"><span>{meta.experience.title}</span><span class="count">{meta.experience.no}</span></h2>
      </div>
      {
        experience.map((e) => (
          <div class="line">
            <p class="mono muted">{e.dates}</p>
            <div>
              <h3 class="line__title">{e.org}</h3>
              <p class="muted">{e.role}</p>
              {e.points.length > 0 && (
                <ul class="points">
                  {e.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))
      }
      <div class="line">
        <p class="mono muted">School</p>
        <div>
          <h3 class="line__title">Work placements</h3>
          <p>{placements.join(', ')}.</p>
        </div>
      </div>
    </section>

    <section class="sheet" style={`--shift: ${meta.skills.shift}`} aria-labelledby="skills">
      <div class="bar sheet__head">
        <h2 id="skills" class="bar__label"><span>{meta.skills.title}</span><span class="count">{meta.skills.no}</span></h2>
      </div>
      <dl class="pairs">
        {
          skills.map((s) => (
            <div class="line">
              <dt class="mono muted">{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sheet" style={`--shift: ${meta.awards.shift}`} aria-labelledby="awards">
      <div class="bar sheet__head">
        <h2 id="awards" class="bar__label"><span>{meta.awards.title}</span><span class="count">{meta.awards.no}</span></h2>
      </div>
      <dl class="pairs">
        {
          awards.map((a) => (
            <div class="line">
              <dt class="mono muted">{a.label}</dt>
              <dd>{a.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sheet" style={`--shift: ${meta.activities.shift}`} aria-labelledby="activities">
      <div class="bar sheet__head">
        <h2 id="activities" class="bar__label"><span>{meta.activities.title}</span><span class="count">{meta.activities.no}</span></h2>
      </div>
      <dl class="pairs">
        {
          activities.map((a) => (
            <div class="line">
              <dt class="mono muted">{a.label}</dt>
              <dd>{a.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sheet" style={`--shift: ${meta.interests.shift}`} aria-labelledby="interests">
      <div class="bar sheet__head">
        <h2 id="interests" class="bar__label"><span>{meta.interests.title}</span><span class="count">{meta.interests.no}</span></h2>
      </div>
      <div class="line">
        <span></span>
        <p class="text">{interests}</p>
      </div>
    </section>

    <section class="sheet" style={`--shift: ${meta.references.shift}`} aria-labelledby="references">
      <div class="bar sheet__head">
        <h2 id="references" class="bar__label"><span>{meta.references.title}</span><span class="count">{meta.references.no}</span></h2>
      </div>
      <div class="line">
        <span></span>
        <p class="text">Available on request.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .crumbs {
    padding-top: 1rem;
  }

  .head {
    padding-top: clamp(2.5rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .head__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.5rem;
  }

  /* A numbered strip of the sections, for orientation. */
  .contents ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contents a {
    text-decoration: none;
  }

  .contents a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Sheet: heading, rule and content move as one block. */
  .sheet {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    scroll-margin-top: calc(var(--chrome) + 1.5rem);
  }

  @media (min-width: 64rem) {
    .sheet {
      margin-left: calc(var(--shift) * 1%);
    }
  }

  .sheet__head {
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--hair);
  }

  /* One grid for every row in every sheet: meta column (dates / labels) + main column. */
  .line {
    display: grid;
    gap: 0.2rem 1.5rem;
    padding-block: 0.7rem;
  }

  @media (min-width: 48rem) {
    .line {
      grid-template-columns: 10rem minmax(0, 38rem);
    }
  }

  .line__title {
    font-weight: 600;
  }

  .text p + p {
    margin-top: 0.6rem;
  }

  .points {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
  }

  .pairs {
    margin: 0;
  }

  .pairs dd {
    margin: 0;
  }

  .pairs dt {
    padding-top: 0.15em;
  }

  @media print {
    .head {
      padding-top: 0;
      padding-bottom: 1rem;
    }

    .sheet {
      margin: 1.25rem 0 0;
      break-inside: avoid;
    }
  }
</style>

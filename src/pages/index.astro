---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Typed from '../components/Typed.astro';
import Work from '../components/Work.astro';
import { site } from '../data/site';
import { education, experience } from '../data/cv';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const notes = [
  { label: 'Studying', value: 'Immersive Software Engineering, UL' },
  { label: 'Languages', value: 'C, Java, Python' },
  { label: 'Outside college', value: 'American football, films' },
  { label: 'Looking for', value: 'Internships and side projects' },
];

type Item = { main: string; side: string; href?: string };
const columns: { title: string; items: Item[] }[] = [
  {
    title: 'Projects',
    items: projects.map((p) => ({ main: p.data.title, side: String(p.data.year), href: `/projects/${p.id}` })),
  },
  { title: 'Experience', items: experience.map((e) => ({ main: e.org, side: e.dates })) },
  { title: 'Education', items: education.map((e) => ({ main: e.org, side: e.dates })) },
  {
    title: 'Elsewhere',
    items: [
      { main: 'Email', side: site.email, href: `mailto:${site.email}` },
      { main: 'GitHub', side: 'AlbusAlbatron', href: site.github },
      { main: 'LinkedIn', side: 'alby-mcnamara', href: site.linkedin },
      { main: 'CV', side: 'Web version', href: '/cv' },
    ],
  },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  jobTitle: site.role,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Limerick' },
  sameAs: [site.github, site.linkedin],
};
---

<Base>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />

  <div class="page">
    <section class="hero" aria-label="Introduction">
      <h1 class="sr-only">{site.name}, {site.role}</h1>
      <Typed
        class="statement hero__text indent-1"
        text="I'm Alby, a first-year software engineering student at the University of Limerick. I mostly work in Java, Python and C."
      />
      <dl class="spec hero__notes small indent-4">
        {
          notes.map((n, i) => (
            <div>
              <dt class="label"><span class="pixel">({String(i + 1).padStart(2, '0')})</span> {n.label}</dt>
              <dd>{n.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="section">
      <Work />
    </div>

    <section class="section" aria-labelledby="everything">
      <div class="bar indent-6">
        <h2 id="everything" class="bar__label"><span>Overview</span></h2>
      </div>
      <div class="columns small">
        {
          columns.map((col) => (
            <div>
              <h3 class="label muted columns__title">{col.title}</h3>
              <ul>
                {col.items.map((item) =>
                  item.href ? (
                    <li>
                      <a href={item.href}>
                        <span data-dust>{item.main}</span>
                        <span class="muted">{item.side}</span>
                      </a>
                    </li>
                  ) : (
                    <li>
                      <span>{item.main}</span>
                      <span class="muted">{item.side}</span>
                    </li>
                  ),
                )}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-top: clamp(3rem, 11vw, 9rem);
  }

  .hero :global(.hero__text) {
    max-width: 24ch;
  }

  .hero__notes {
    margin-top: clamp(3rem, 9vw, 8rem);
  }

  .hero__notes dt {
    color: var(--muted);
  }

  /* Overview columns sit at staggered heights. */
  @media (min-width: 64rem) {
    .columns {
      padding-bottom: 4rem;
    }

    .columns > div:nth-child(2) {
      translate: 0 3.5rem;
    }

    .columns > div:nth-child(3) {
      translate: 0 -1rem;
    }

    .columns > div:nth-child(4) {
      translate: 0 5.5rem;
    }
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem var(--gap);
    margin-top: 1rem;
  }

  .columns__title {
    margin-bottom: 0.4rem;
  }

  .columns ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .columns li > a,
  .columns li > span:first-child {
    display: inline;
  }

  .columns li > a,
  .columns li:not(:has(a)) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.3rem;
    text-decoration: none;
  }

  .columns li > a:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .columns li span:last-child {
    text-align: right;
  }
</style>

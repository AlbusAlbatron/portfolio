---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import SplitText from '../components/SplitText.astro';

const info = [
  { label: 'Based in', value: 'Limerick, Ireland', clock: true },
  { label: 'Studying', value: 'Immersive Software Engineering, UL' },
  { label: 'Building', value: 'Low-level tools in C & Win32' },
  { label: 'Off the clock', value: 'American football, films' },
];
---

<Base>
  <section class="hero wrap" data-surface="dark">
    <div class="hero__scene" data-hero-scene aria-hidden="true"></div>
    <p class="label" data-reveal>Software engineering student — University of Limerick</p>
    <SplitText text="Alby" by="char" class="hero__name" delay={120} data-parallax="0.18" />
    <p class="hero__intro" data-reveal style="--reveal-delay: 180">
      I'm a first-year Immersive Software Engineering student. I like finding strange things to make a computer
      do — mostly in C, mostly by talking straight to Windows.
    </p>
    <div class="hero__actions" data-reveal style="--reveal-delay: 260">
      <a class="button" href="/projects/wingravity">Play with WinGravity</a>
      <a class="button button--ghost" href="/about">About me</a>
    </div>
    <dl class="hero__info" data-tilt="5" data-glare>
      {
        info.map((item, i) => (
          <div class="hero__fact" data-reveal style={`--reveal-delay: ${300 + i * 80}`}>
            <dt class="label">{item.label}</dt>
            <dd>
              {item.value}
              {item.clock && (
                <>
                  {' '}
                  <span class="hero__clock" data-clock hidden>
                    · <time />
                  </span>
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap section" aria-labelledby="work" data-surface="light">
    <h2 id="work" class="label section__label" data-reveal>Selected work</h2>
    <ProjectList />
  </section>

  <section class="wrap section teaser" aria-labelledby="more" data-surface="light">
    <h2 id="more" class="label section__label" data-reveal>Off the keyboard</h2>
    <p class="teaser__text" data-reveal data-liquid>
      When I'm not writing C, I'm playing American football for UL or watching films.
    </p>
    <div class="hero__actions" data-reveal>
      <a class="button button--ghost" href="/about">More about me</a>
      <a class="button button--ghost" href="/cv">Read my CV</a>
    </div>
  </section>
</Base>

<script>
  let timer: number | undefined;

  const format = new Intl.DateTimeFormat('en-IE', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Dublin',
  });

  document.addEventListener('astro:page-load', () => {
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    if (!clock) return;
    const time = clock.querySelector('time')!;
    const tick = () => (time.textContent = format.format(new Date()));
    tick();
    clock.hidden = false;
    timer = window.setInterval(tick, 30_000);
  });

  document.addEventListener('astro:before-swap', () => clearInterval(timer));
</script>

<script>
  let dispose: (() => void) | undefined;
  let scheduled = 0;

  const supportsWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };

  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector<HTMLElement>('[data-hero-scene]');
    if (!container || !supportsWebGL()) return;
    // Wait for the page wipe and headline to finish, then build the scene in idle time.
    const mount = async () => {
      if (!container.isConnected) return;
      const { mountHero3D } = await import('../scripts/hero3d');
      const cleanup = await mountHero3D(container);
      if (container.isConnected) dispose = cleanup;
      else cleanup();
    };
    scheduled = window.setTimeout(() => {
      if ('requestIdleCallback' in window) requestIdleCallback(mount, { timeout: 1000 });
      else mount();
    }, 900);
  });

  document.addEventListener('astro:before-swap', () => {
    clearTimeout(scheduled);
    dispose?.();
    dispose = undefined;
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem);
    grid-template-areas:
      'label label'
      'name info'
      'intro info'
      'actions info';
    column-gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 14vw, 10rem) clamp(3rem, 8vw, 6rem);
  }

  .hero > :not(.hero__scene) {
    position: relative;
    z-index: 1;
  }

  .hero__scene {
    position: absolute;
    /* Bleed past the content column to the viewport edge so windows aren't clipped. */
    inset: 0 calc((100% - 100vw) / 2) 0 42%;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .hero__scene.is-ready {
    opacity: 1;
  }

  .hero__scene :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero > .label {
    grid-area: label;
  }

  .hero__name {
    grid-area: name;
  }

  .hero__intro {
    grid-area: intro;
  }

  .hero > .hero__actions {
    grid-area: actions;
  }

  .hero__info {
    grid-area: info;
    align-self: center;
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0.4rem 1.25rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }

  .hero__fact {
    padding: 0.85rem 0;
  }

  .hero__fact + .hero__fact {
    border-top: 1px solid var(--line);
  }

  .hero__fact dd {
    margin: 0.3rem 0 0;
  }

  .hero__clock time {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 48rem) {
    .hero__scene {
      inset: 0 calc((100% - 100vw) / 2) auto 35%;
      height: 15rem;
      pointer-events: none;
    }

    .hero__scene.is-ready {
      opacity: 0.4;
    }

    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: 'label' 'name' 'intro' 'actions' 'info';
    }

    .hero__info {
      margin-top: 3rem;
    }
  }

  .hero__name {
    margin: 0.2em 0 0.15em;
    font-size: clamp(5rem, 22vw, 16rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.85;
    margin-left: -0.05em;
  }

  .hero__intro {
    max-width: 36rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .section {
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  .section__label {
    margin-bottom: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .teaser__text {
    max-width: 44rem;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
</style>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SplitText from '../../components/SplitText.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getPosts, readingTime, dateFormat } from '../../data/journal';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = `/og/journal/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  mainEntityOfPage: pageUrl,
  image: new URL(ogImage, Astro.site).href,
  keywords: post.data.tags.join(', '),
};
---

<Base title={post.data.title} description={post.data.summary} ogImage={ogImage}>
  <JsonLd data={jsonLd} />
  <article>
    <header class="wrap jhead" data-surface="dark" data-index="Top">
      <a href="/journal" class="label jhead__back" data-reveal>← Journal</a>
      <SplitText text={post.data.title} delay={60} data-parallax="0.1" />
      <p class="jhead__meta label" data-reveal style="--reveal-delay: 140">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateFormat.format(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        {minutes} min read
        {post.data.tags.map((t) => <span class="jhead__tag">{t}</span>)}
      </p>
    </header>
    <div class="wrap" data-surface="light">
      <div class="prose" data-reveal>
        <p class="lede">{post.data.summary}</p>
        <Content />
      </div>
      <p class="jfoot" data-reveal>
        <a href="/journal">← All notes</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .jhead {
    padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
  }

  .jhead__back {
    text-decoration: none;
  }

  .jhead__back:hover {
    color: var(--text);
  }

  h1 {
    max-width: 22ch;
    margin-top: 0.5em;
    font-size: clamp(2.25rem, 7vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .jhead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
  }

  .jhead__tag {
    padding: 0.1em 0.6em;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .prose {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text) !important;
  }

  .jfoot {
    margin-top: 3rem;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import SplitText from '../../components/SplitText.astro';
import { getPosts, readingTime, dateFormat } from '../../data/journal';

const posts = await getPosts();
const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  years.set(y, [...(years.get(y) ?? []), p]);
}
---

<Base
  title="Journal"
  description="Short notes by Alby McNamara on what I'm building and learning as a software engineering student."
  ogImage="/og/journal.png"
>
  <section class="wrap head" data-surface="dark">
    <p class="label" data-reveal>Journal</p>
    <SplitText text="Notes as I go" delay={80} data-parallax="0.12" />
    <p class="head__intro" data-reveal style="--reveal-delay: 160">
      Short write-ups of things I built, broke or finally understood. Mostly for me; you're welcome to read along.
      There's an <a href="/rss.xml">RSS feed</a>.
    </p>
  </section>

  <div class="wrap" data-surface="light">
    {posts.length === 0 && <p class="empty" data-reveal>Nothing here yet.</p>}
    {
      [...years.entries()].map(([year, list]) => (
        <section class="year" aria-labelledby={`y-${year}`} data-index={String(year)}>
          <h2 id={`y-${year}`} class="label year__label" data-reveal>
            {year}
          </h2>
          <ol class="posts">
            {list.map((p, i) => (
              <li data-reveal style={`--reveal-delay: ${i * 70}`}>
                <a class="post" href={`/journal/${p.id}`} data-cursor="view">
                  <time class="post__date label" datetime={p.data.date.toISOString().slice(0, 10)}>
                    {dateFormat.format(p.data.date)}
                  </time>
                  <span class="post__title">{p.data.title}</span>
                  <span class="post__summary">{p.data.summary}</span>
                  <span class="post__meta label">
                    {readingTime(p.body)} min read
                    {p.data.tags.map((t) => (
                      <span class="post__tag">{t}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(2rem, 6vw, 4rem);
  }

  h1 {
    margin-top: 0.4em;
    font-size: clamp(2.75rem, 9vw, 6rem);
    letter-spacing: -0.05em;
  }

  .head__intro {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .empty {
    padding-block: 3rem;
    color: var(--text-muted);
  }

  .year {
    display: grid;
    grid-template-columns: minmax(6rem, 1fr) 5fr;
    gap: 1rem 2rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .year__label {
    margin: 0;
    padding-top: 0.35rem;
    font-weight: 400;
  }

  .posts {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li + li {
    border-top: 1px solid var(--line);
  }

  .post {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding: 1.25rem 0;
    text-decoration: none;
  }

  .post__title {
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: translate 0.5s var(--ease);
  }

  .post:hover .post__title {
    translate: 0.4rem 0;
  }

  .post__summary {
    max-width: 40rem;
    color: var(--text-muted);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }

  .post__tag {
    padding: 0.1em 0.6em;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  @media (max-width: 40rem) {
    .year {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>

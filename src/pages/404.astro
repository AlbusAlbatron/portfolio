---
import Base from '../layouts/Base.astro';
import Typed from '../components/Typed.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <div class="page">
    <header class="head">
      <p class="mono muted">404</p>
      <h1 class="sr-only">Page not found</h1>
      <Typed class="title head__msg outdent" text="Page not found." />
      <p class="lede head__lede indent-2">This page doesn't exist, or it has moved.</p>
      <p class="head__links small">
        <a class="link" href="/" data-dust>Home</a>
        <a class="link" href="/projects" data-dust>Work</a>
      </p>
    </header>
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(3rem, 12vw, 9rem);
  }

  .head :global(.head__msg) {
    margin-top: 1rem;
  }

  .head__lede {
    margin-top: 1.25rem;
  }

  .head__links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Typed from '../components/Typed.astro';
import { site } from '../data/site';

// Drop a photo (jpg/png/webp) into src/assets/about/ and it appears automatically.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;

const facts = [
  { label: 'Studying', value: 'Immersive Software Engineering, UL' },
  { label: 'From', value: 'Clonmel, Co. Tipperary' },
  { label: 'Writing', value: 'C, Java, Python' },
  { label: 'Outside college', value: 'American football, films' },
];
---

<Base
  title="About"
  description="About Alby McNamara, a first-year Immersive Software Engineering student at the University of Limerick."
>
  <div class="page">
    <header class="head">
      <h1 class="title dust-title outdent" data-dust>About</h1>
      <Typed class="lede head__lede indent-2" text="I'm Alby. I study software engineering at the University of Limerick." />
    </header>

    <div class="layout">
      <aside aria-label="Quick facts" class="drop-2">
        <p class="band--mini">Quick facts</p>
        {
          photo && (
            <span class="tile photo-tile">
              <Image class="photo develop" src={photo} alt="Alby McNamara" widths={[360, 720]} sizes="22rem" />
            </span>
          )
        }
        <dl class="facts small">
            {
              facts.map((f) => (
                <div>
                  <dt class="label muted">{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
        </dl>
      </aside>

      <div class="prose">
        <h2>How I got into this</h2>
        <p>
          I got into programming by messing around with what my own computer would let me do. Most of my
          projects start with a question I want answered, and I keep going until I have one.
        </p>
        <p>
          <a href="/projects/wingravity">WinGravity</a> and
          <a href="/projects/attention-service">Attention Service</a> both started that way.
        </p>
        <p>
          I'm in first year of Immersive Software Engineering at UL, where I'm learning Java, Python and C
          properly, along with Git.
        </p>
        <h2>Outside of code</h2>
        <p>
          I play American football for UL. Before college I played football and basketball for my school and
          helped coach underage teams at Clonmel Commercials. I've also worked part-time at a service station,
          in a hotel restaurant and as an exam attendant. I watch a lot of films.
        </p>
        <h2>Get in touch</h2>
        <p>
          Email me at <a href={`mailto:${site.email}`}>{site.email}</a>, or find me on
          <a href={site.linkedin}>LinkedIn</a> and <a href={site.github}>GitHub</a>.
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(3rem, 9vw, 7rem);
  }

  .head :global(.head__lede) {
    max-width: 26ch;
    margin-top: 1.25rem;
  }

  .layout {
    display: grid;
    gap: 3rem var(--gap);
    margin-top: var(--section);
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }

    aside {
      position: sticky;
      top: calc(var(--chrome) + 1.5rem);
      max-width: 22rem;
    }
  }

  .photo-tile {
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .photo {
    width: 100%;
    border-radius: 10px;
  }

  .facts {
    margin: 0;
  }

  .facts div {
    padding-block: 0.45rem;
  }

  .facts dd {
    margin: 0.1rem 0 0;
  }
</style>

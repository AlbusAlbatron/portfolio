---
import { getEntry } from 'astro:content';
import { Code } from 'astro:components';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { SEGMENTS, SHRINK, FOLLOW, HEAD_RADIUS, TICK_HZ } from '../../scripts/snake/engine';

const project = (await getEntry('projects', 'procedural-animation'))!;

// The radii the C produces: (int)(prev * 0.8) each step, until it hits zero.
const radii: number[] = [HEAD_RADIUS];
while (radii[radii.length - 1] > 0) radii.push(Math.trunc(radii[radii.length - 1] * SHRINK));
const zeroAt = radii.length; // 1-based index of the first zero-radius segment

const cSnippet = `int motion(Circle* circle_line, int circle_count, Vector2 head_pos){
    Vector2 prev_pos = head_pos;
    Vector2 temp_pos;

    for (int i = 1; i < circle_count; i++){
        //Check if distance between to centres are greater than radius
        if (Vector2Distance(circle_line[i - 1].center, circle_line[i].center) > circle_line[i - 1].radius){
            //Move circle i towards circle [i-1]'s last postion
            temp_pos = circle_line[i].center;
            circle_line[i].center = Vector2Lerp(circle_line[i].center, prev_pos, 0.03f);
            prev_pos = temp_pos;
        }
        else{
            prev_pos = circle_line[i].center;
        }
    }
    return 0;
}`;

const tsSnippet = `let prevX = c.x[0];
let prevY = c.y[0];
for (let i = 1; i < c.n; i++) {
  const px = c.x[i];
  const py = c.y[i];
  const dx = c.x[i - 1] - px;
  const dy = c.y[i - 1] - py;
  if (Math.sqrt(dx * dx + dy * dy) > c.r[i - 1]) {
    c.x[i] += (prevX - px) * k;
    c.y[i] += (prevY - py) * k;
  }
  prevX = px;
  prevY = py;
}`;

const theme = 'css-variables';
---

<ProjectLayout project={project}>
  <section class="wrap" aria-label="Interactive procedural animation demo">
    <div class="snake theme-dark" data-snake-root data-reveal>
      <div class="snake__stage">
        <canvas
          class="snake__canvas"
          data-snake-canvas
          width="800"
          height="450"
          role="img"
          aria-label="A chain of forty circles, shrinking towards the tail, that follows the pointer around"
        ></canvas>
        <p class="snake__hint label" aria-hidden="true">
          <span class="snake__hint--mouse">Move your mouse over the canvas</span>
          <span class="snake__hint--touch">Press and drag to lead it</span>
        </p>
        <pre class="snake__readout" data-snake-readout aria-live="off">waiting for input…</pre>
      </div>

      <fieldset class="snake__tweaks">
        <legend class="label">Tweaks</legend>
        <div class="snake__tweak">
          <label for="snake-segments">Segments</label>
          <input id="snake-segments" type="range" min="5" max="80" step="1" value={SEGMENTS} data-snake="segments" />
          <output for="snake-segments" data-snake-out="segments">{SEGMENTS}</output>
        </div>
        <div class="snake__tweak">
          <label for="snake-shrink">Shrink per segment</label>
          <input id="snake-shrink" type="range" min="0.5" max="0.98" step="0.01" value={SHRINK} data-snake="shrink" aria-describedby="snake-shrink-help" />
          <output for="snake-shrink" data-snake-out="shrink">{SHRINK.toFixed(2)}</output>
        </div>
        <div class="snake__tweak">
          <label for="snake-follow">Follow speed</label>
          <input id="snake-follow" type="range" min="0.01" max="0.2" step="0.005" value={FOLLOW} data-snake="follow" />
          <output for="snake-follow" data-snake-out="follow">{FOLLOW.toFixed(3)}</output>
        </div>
        <p id="snake-shrink-help" class="snake__help">
          In the original the radii are rounded down to whole pixels, so from segment {zeroAt} on they are 0 and the
          tail is just dots. Push shrink above 0.9 and the whole chain survives.
        </p>
        <button type="button" class="button button--ghost snake__reset" data-snake-reset>Back to the original</button>
      </fieldset>
    </div>
  </section>

  <div class="wrap">
    <div class="prose case" data-reveal>
      <h2>The idea</h2>
      <p>
        I'd seen videos of procedurally animated creatures — snakes, fish, lizards — where nothing is keyframed
        and the body just follows the head. I wanted to know how little code it took to get that feeling. The
        answer is about a hundred lines of C and one rule.
      </p>

      <h2>How it works</h2>
      <h3>One rule</h3>
      <p>
        The body is an array of circles. Every frame the head moves 3% of the way towards the mouse. Then, for
        each circle after it: if it has drifted further from the one in front than that circle's radius, pull it
        3% of the way towards where the one in front <em>used to be</em>. Otherwise leave it alone. That lag — chasing
        the previous position rather than the current one — is what makes the body swing round corners instead of
        snapping into a straight line.
      </p>
      <h3>Shrinking radii</h3>
      <p>
        Each circle's radius is 80% of the one before it, stored as an <code>int</code>. Starting from {HEAD_RADIUS} that gives
        {radii.filter((r) => r > 0).join(', ')} — and then 0, because <code>(int)(1 * 0.8)</code> is 0. From segment {zeroAt} to {SEGMENTS}
        the circles have no size at all, which is why the original tail is a line of dots. I only noticed when I
        ported it.
      </p>
      <h3>The loop</h3>
      <p>
        raylib runs the loop at a target of {TICK_HZ} frames a second, and the 3% lerp is applied once per frame.
        That ties the feel of the animation to the frame rate: on a slower machine the snake is slower. It's a
        classic mistake and it's one I'd fix with a timestep now.
      </p>

      <h2>Bringing it to the browser</h2>
      <p>
        The demo above is the same algorithm in TypeScript, drawn on a canvas in the C program's 800 × 450 pixel
        coordinates. To keep the feel identical I step the simulation {TICK_HZ} times a second with an accumulator,
        whatever the display refresh rate is, so the per-frame lerp means the same thing it did in raylib. The
        sliders aren't in the original — they're there so you can see what each number does.
      </p>
    </div>

    <div class="compare" data-reveal>
      <figure>
        <figcaption class="label">procedural_snake.c</figcaption>
        <Code code={cSnippet} lang="c" theme={theme} />
      </figure>
      <figure>
        <figcaption class="label">engine.ts</figcaption>
        <Code code={tsSnippet} lang="ts" theme={theme} />
      </figure>
    </div>

    <div class="prose case" data-reveal>
      <h2>What I learned</h2>
      <ul>
        <li>
          <strong>Following the past, not the present.</strong> The whole effect comes from one variable holding
          the previous circle's old position. Change it to the new position and the snake turns into a rigid rod.
        </li>
        <li>
          <strong>Integer truncation is silent.</strong> Nothing warned me that two thirds of my circles had a
          radius of zero. Drawing the data you're computing is the fastest way to find that out.
        </li>
        <li>
          <strong>Frame-rate independence.</strong> Multiplying by a lerp factor every frame is not the same as
          moving at a speed. Porting it made me measure time properly for the first time.
        </li>
      </ul>

      <h2>What's next</h2>
      <ul>
        <li>Give the body a skin: connect the circle edges into one outline instead of drawing rings.</li>
        <li>Add constraints on how sharply the chain can bend, so it stops folding back through itself.</li>
        <li>Legs. Lizards next.</li>
      </ul>
    </div>
  </div>
</ProjectLayout>

<script>
  import { mountSnake } from '../../scripts/snake/canvas';

  let unmount: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-snake-root]');
    if (root) unmount = mountSnake(root);
  });

  document.addEventListener('astro:before-swap', () => {
    unmount?.();
    unmount = undefined;
  });
</script>

<style>
  .snake {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 17rem);
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
  }

  .snake__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--text) 9%, transparent) 1px, transparent 0) 0 0 /
        22px 22px,
      var(--bg-sunken);
  }

  .snake__canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: crosshair;
  }

  .snake__hint {
    position: absolute;
    left: 0.9rem;
    bottom: 0.75rem;
    margin: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }

  .snake__hint--touch {
    display: none;
  }

  @media (hover: none) {
    .snake__hint--mouse {
      display: none;
    }

    .snake__hint--touch {
      display: inline;
    }
  }

  .snake__readout {
    position: absolute;
    right: 0.9rem;
    top: 0.75rem;
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--text-muted);
    pointer-events: none;
  }

  .snake__tweaks {
    display: grid;
    align-content: start;
    gap: 1rem;
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .snake__tweaks legend {
    padding: 0 0.4em;
  }

  .snake__tweak {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.75rem;
    font-size: 0.9rem;
  }

  .snake__tweak input {
    grid-column: 1 / -1;
    width: 100%;
    margin: 0;
    accent-color: var(--text);
  }

  .snake__tweak output {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .snake__help {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .snake__reset {
    justify-self: start;
    font-size: 0.85rem;
  }

  .snake:global(.is-original) .snake__reset {
    color: var(--text-muted);
    border-color: var(--line);
  }

  @media (max-width: 48rem) {
    .snake {
      grid-template-columns: 1fr;
    }

    .snake__readout {
      display: none;
    }
  }

  .case {
    margin-top: clamp(2rem, 6vw, 4rem);
  }

  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .compare figure {
    margin: 0;
    min-width: 0;
  }

  .compare figcaption {
    margin-bottom: 0.5rem;
  }

  .compare :global(pre) {
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px solid #463d35;
    border-radius: 8px;
    background: #1e1915 !important;
    font-size: 0.78rem;
    line-height: 1.55;
    overflow-x: auto;
  }
</style>

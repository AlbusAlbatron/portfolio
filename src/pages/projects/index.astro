---
import Base from '../../layouts/Base.astro';
import Typed from '../../components/Typed.astro';
import Work from '../../components/Work.astro';
---

<Base title="Work" description="Projects by Alby McNamara, a software engineering student at the University of Limerick.">
  <div class="page">
    <header class="head">
      <h1 class="title dust-title outdent" data-dust>Work</h1>
      <Typed
        class="lede head__lede indent-2"
        text="Projects I've built outside of class. Each one has a short write-up on how it works and what I learned."
      />
    </header>
    <div class="section work">
      <Work heading="Projects" />
    </div>
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(3rem, 9vw, 7rem);
  }

  .head :global(.head__lede) {
    max-width: 30ch;
    margin-top: 1.25rem;
  }

  .work {
    margin-top: clamp(3rem, 8vw, 5rem);
  }
</style>

---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import SplitText from '../../components/SplitText.astro';
---

<Base title="Projects" description="Projects by Alby McNamara, a software engineering student at the University of Limerick.">
  <section class="wrap head" data-surface="dark">
    <p class="label" data-reveal>Projects</p>
    <SplitText text="Things I've built" delay={80} data-parallax="0.12" />
    <p class="head__intro" data-reveal style="--reveal-delay: 160">
      What I've built so far. Each one started with a question I couldn't stop thinking about.
    </p>
  </section>
  <section class="wrap" data-surface="light">
    <ProjectList />
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(2rem, 6vw, 4rem);
  }

  h1 {
    margin-top: 0.4em;
    font-size: clamp(2.75rem, 9vw, 6rem);
    letter-spacing: -0.05em;
  }

  .head__intro {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: var(--text-muted);
  }
</style>
